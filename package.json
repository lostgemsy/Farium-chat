{
  "name": "farius-chat",
  "version": "2.0.0",
  "private": true,
  "description": "Farius — a monochrome, real-time chat with global rooms, friends, groups, moderation, uploads, and WebRTC calling.",
  "keywords": [
    "chat",
    "realtime",
    "socket.io",
    "webrtc",
    "express",
    "monochrome"
  ],
  "license": "MIT",
  "author": "Farius",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "clean": "node -e \"const fs=require('fs');for(const p of ['data/db.json','data/db.json.tmp']){try{fs.unlinkSync(p);console.log('removed',p)}catch{}}\"",
    "reset": "npm run clean && echo \"Fresh DB will be created on next start.\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  }
}